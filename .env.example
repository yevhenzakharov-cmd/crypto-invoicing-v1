# Free project ID from https://cloud.reown.com (WalletConnect). Without it,
# only browser-extension wallets (MetaMask, Rabby, Coinbase) are offered.
NEXT_PUBLIC_WC_PROJECT_ID=

# Secret used to encrypt the sign-in session cookie. Required in production.
# Generate one with:  openssl rand -base64 32
SESSION_SECRET=

# Optional: your own RPC endpoints (recommended for production and privacy).
# Leave empty to use each chain's public RPC.
NEXT_PUBLIC_RPC_MAINNET=
NEXT_PUBLIC_RPC_BASE=
NEXT_PUBLIC_RPC_ARBITRUM=
NEXT_PUBLIC_RPC_POLYGON=
